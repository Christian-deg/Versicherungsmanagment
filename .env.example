# OpenAI API
OPENAI_API_KEY=sk-replace-me

# Pushover Push-Benachrichtigungen
# https://pushover.net/  → Your User Key + Application API Token
PUSHOVER_USER_KEY=replace-me
PUSHOVER_APP_TOKEN=replace-me

# Automatische Backups (täglich 03:30, 7 Tage + 12 Monate aufbewahrt).
# Standard: Ordner ./backups neben data/. Für Schutz vor Festplattenausfall
# ein anderes Laufwerk, NAS oder einen Cloud-Sync-Ordner angeben:
# BACKUP_HOST_DIR=D:/Backups/versicherung

# Optional Overrides
# DATA_DIR=./data
# LOG_LEVEL=INFO
# Modelle (Stand 09/2026, siehe AGENTS.md "Modelle"):
# MODEL_DOCUMENT=gpt-5.6-terra   # Vision-Extraktion (Policen, Belegfotos)
# MODEL_CHAT=gpt-5.6-terra       # Chat/RAG + Empfehlungen
# MODEL_FAST=gpt-5.6-luna        # Klassifizierung, Evaluator, Beleg-Textlayer, OCR
# REASONING_EFFORT=low           # none|minimal|low|medium|high — zählt gegen Token-Limits
# Achtung: Wechsel des Embedding-Modells macht den Suchindex ungültig
# (data/vectordb leeren, danach Chat-Seite → "Suchindex prüfen")
# MODEL_EMBEDDING=text-embedding-3-small

# Web-Suche für RecommendationAgent
# Provider: serper (Standard) oder brave
SEARCH_PROVIDER=serper
SEARCH_API_KEY=replace-me
